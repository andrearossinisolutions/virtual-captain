# Definitive vhost. certbot --apache creates virtual-captain-le-ssl.conf: compare it
# with this file and keep the certificate lines it generated (SSLCertificate*, Include).
# Modules needed: proxy proxy_http proxy_wstunnel rewrite headers ssl
<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName virtualcaptain.rossinisolutions.com
    ServerAlias www.virtualcaptain.rossinisolutions.com

    # www -> bare domain
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://virtualcaptain.rossinisolutions.com%{REQUEST_URI} [R=301,L]

    # HSTS short for now (1 day); raise it once everything is verified
    Header always set Strict-Transport-Security "max-age=86400"

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"

    # WebSocket (prepared for the next steps; the app has no /ws/ yet)
    ProxyPass        /ws/ ws://127.0.0.1:8100/ws/
    ProxyPassReverse /ws/ ws://127.0.0.1:8100/ws/

    # certbot renewals are answered by Apache, not by the app
    ProxyPass /.well-known !

    ProxyPass        / http://127.0.0.1:8100/
    ProxyPassReverse / http://127.0.0.1:8100/

    ErrorLog ${APACHE_LOG_DIR}/virtual-captain-error.log
    CustomLog ${APACHE_LOG_DIR}/virtual-captain-access.log combined

    # certbot lines (keep the ones it generated)
    SSLCertificateFile /etc/letsencrypt/live/virtualcaptain.rossinisolutions.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/virtualcaptain.rossinisolutions.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
