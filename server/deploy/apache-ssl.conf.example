# Definitive vhost. certbot --apache creates virtual-captain-le-ssl.conf: compare it
# with this file and keep the certificate lines it generated (SSLCertificate*, Include).
# Modules needed: proxy proxy_http proxy_wstunnel rewrite headers ssl
<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName virtualcaptain.rossinisolutions.com
    ServerAlias www.virtualcaptain.rossinisolutions.com

    # www -> bare domain
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://virtualcaptain.rossinisolutions.com%{REQUEST_URI} [R=301,L]

    # HSTS: 1 year, WITHOUT includeSubDomains and WITHOUT preload on purpose.
    # Andrea raises it (or adds them) only after confirming that HTTPS works everywhere.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Request bodies: the app already caps them at 8 KB (413); Apache drops bigger ones first.
    # Applies to HTTP request bodies only (JSON API, forms). It does not touch WebSocket frames
    # (the /ws/ upgrade has no body; frame size is capped by uvicorn --ws-max-size).
    # The site has no file uploads: if one is ever added, raise this value for that path only.
    LimitRequestBody 16384

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    # Drop any X-Forwarded-For sent by the client. mod_proxy then adds the real client IP
    # as the only value; app.py trusts the LAST value of X-Forwarded-For, so the real IP
    # keeps working and a forged header can no longer reach the app.
    RequestHeader unset X-Forwarded-For

    # WebSocket (prepared for the next steps; the app has no /ws/ yet)
    ProxyPass        /ws/ ws://127.0.0.1:8100/ws/
    ProxyPassReverse /ws/ ws://127.0.0.1:8100/ws/

    # SSE stream (GET /api/flight/stream). Must come BEFORE the generic "ProxyPass /" (first match wins).
    # - flushpackets=on: pass every chunk to the browser at once (no buffering in mod_proxy_http).
    # - timeout=90: backend inactivity limit; the app sends a ": hb" comment every 15 s and a "meta" every 5 s.
    # - disablereuse=on: one backend connection per stream, never put back in the pool.
    # - mod_deflate is the first suspect for partial buffering: no-gzip + drop Accept-Encoding for this path.
    #   (text/event-stream is not in the default DEFLATE list, but a custom AddOutputFilterByType could add it.)
    # - No cache: the app already answers Cache-Control: no-store; Apache adds nothing.
    # - X-Accel-Buffering is an nginx header, irrelevant for Apache (the app may send it, harmless).
    # - Concurrency caps live in the app (3 per user, 10 per IP, 40 global; 429 beyond them and the
    #   client polls). Apache needs MaxRequestWorkers well above 40 + normal traffic (mpm_event: check
    #   with "apachectl -V | grep -i mpm" and "apachectl -M | grep mpm"); 40 streams hold 40 workers' slots.
    # - Apache "Timeout" (default 60 s on Ubuntu) bounds a stalled write to the client; the app ends a
    #   blocked write after 25 s (STREAM_WRITE_TIMEOUT_SECONDS) and a stream lives at most 15 min, then
    #   the client reconnects with Last-Event-ID: no Timeout change is needed. Do NOT lower it under 30 s.
    # - LimitRequestBody does not matter here (GET without body).
    <Location /api/flight/stream>
        SetEnv no-gzip 1
        SetEnv dont-vary 1
        RequestHeader unset Accept-Encoding
        Header always set Cache-Control "no-store"
    </Location>
    ProxyPass        /api/flight/stream http://127.0.0.1:8100/api/flight/stream flushpackets=on timeout=90 disablereuse=on
    ProxyPassReverse /api/flight/stream http://127.0.0.1:8100/api/flight/stream

    # certbot renewals are answered by Apache, not by the app
    ProxyPass /.well-known !

    ProxyPass        / http://127.0.0.1:8100/
    ProxyPassReverse / http://127.0.0.1:8100/

    # Own subfolder: the stock logrotate (/etc/logrotate.d/apache2, pattern *.log) does not
    # descend into it, so only deploy/logrotate-virtual-captain (14 days) rotates these.
    # Create it first: sudo install -d -o root -g adm -m 750 /var/log/apache2/virtual-captain
    ErrorLog ${APACHE_LOG_DIR}/virtual-captain/error.log
    CustomLog ${APACHE_LOG_DIR}/virtual-captain/access.log combined

    # certbot lines (keep the ones it generated)
    SSLCertificateFile /etc/letsencrypt/live/virtualcaptain.rossinisolutions.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/virtualcaptain.rossinisolutions.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
