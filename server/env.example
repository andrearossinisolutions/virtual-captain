# Names only. The real file lives on the VPS at /etc/virtual-captain/env (root, 600).
# Never put values here: this repository is PUBLIC.
# VC_REVISION_FILE
# Email (step 2a) - NAME=value, one per line, no quotes
SMTP_HOST
SMTP_PORT
SMTP_USER
SMTP_PASSWORD
MAIL_FROM
# optional:
# MAIL_FROM_NAME
# SMTP_TIMEOUT
# MAIL_ENVELOPE_FROM
# Accounts (step 2b-1)
# set SECRET_KEY first; PUBLIC_BASE_URL without SECRET_KEY refuses to start
SECRET_KEY
PUBLIC_BASE_URL
# optional:
# DB_PATH
# RATE_IP_HOURLY
# RATE_IP_DAILY
# RATE_MAIL_ADDR_HOURLY
# RATE_MAIL_DAILY
# LOGIN_MAX_FAILURES
# LOCKOUT_MINUTES
# RATE_LOGIN_IP_15MIN
