# Names only. The real file lives on the VPS at /etc/virtual-captain/env (root, 600).
# Never put values here: this repository is PUBLIC.
# VC_REVISION_FILE
# Email (step 2a) - NAME=value, one per line, no quotes
SMTP_HOST
SMTP_PORT
SMTP_USER
SMTP_PASSWORD
MAIL_FROM
# optional:
# MAIL_FROM_NAME
# SMTP_TIMEOUT
# MAIL_ENVELOPE_FROM
# Accounts (step 2b-1)
# set SECRET_KEY first; PUBLIC_BASE_URL without SECRET_KEY refuses to start
SECRET_KEY
PUBLIC_BASE_URL
# optional:
# DB_PATH
# RATE_IP_HOURLY
# RATE_IP_DAILY
# RATE_MAIL_ADDR_HOURLY
# RATE_MAIL_DAILY
# LOGIN_MAX_FAILURES
# LOCKOUT_MINUTES
# RATE_LOGIN_IP_15MIN
# RATE_PREVIEW_IP_HOURLY
# Device-code login of the PC program (step 2c), all optional
# RATE_DEVICE_START_IP_HOURLY
# RATE_DEVICE_START_IP_DAILY
# RATE_DEVICE_POLL_IP_MINUTE
# RATE_DEVICE_TOKEN_IP_MINUTE
# DEVICE_CODE_TTL_SECONDS
# DEVICE_POLL_INTERVAL_SECONDS
# DEVICE_ACCESS_TTL_SECONDS
# DEVICE_REFRESH_TTL_DAYS
# DEVICE_LOOKUP_MAX_FAILURES
# DEVICE_LOOKUP_LOCK_MINUTES
# Uplink of the PC program (WebSocket /ws/agent), all optional
# AGENT_MAX
# RATE_AGENT_IP_MINUTE
# AGENT_MSGS_PER_SECOND
# AGENT_STALE_SECONDS
# AGENT_HELLO_TIMEOUT_SECONDS
# AGENT_FAMILY_RECHECK_SECONDS
# AGENT_MAX_LIFETIME_SECONDS
